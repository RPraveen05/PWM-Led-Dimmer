`timescale 1ns / 1ps

module LED_Dimmer(
    input clk,
    input button,
    input [7:0] sw,
    output reg led_out
    );
    
    localparam BIT_WIDTH = 8;
    
    reg [BIT_WIDTH - 1:0] counter;
    wire rst;
    
    assign rst = button;
    
    always @(posedge clk or posedge rst) begin
    if(rst) 
     counter <= 8'd0;
    else
    counter <= counter + 1'b1;
    end
    
    always @(posedge clk or posedge rst) begin
    if(rst) 
     led_out <= 1'b0;
    else begin
    if(sw == 8'd0) 
     led_out <= 1'b0;
    else if(sw == 8'hFF) 
    led_out <= 1'b1; 
    else
    led_out <= (counter < sw ) ? 1'b1 : 1'b0; 
    end
    end
endmodule
